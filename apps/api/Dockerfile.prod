FROM node:22-alpine AS base
RUN apk add --no-cache wget openssl && npm install -g pnpm@10.32.1

# Single stage: the previous deps/runner split existed purely to cache the
# install, and that split is what breaks -- COPY --from=deps lays down
# node_modules which the subsequent source COPY then replaces. See
# Dockerfile.migrate for the full explanation.
FROM base AS runner
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/chess/package.json ./packages/chess/

COPY packages/chess ./packages/chess
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile && pnpm store prune

RUN pnpm --filter @aurora/api run db:generate
ENV NODE_ENV=production

EXPOSE 3001
CMD ["pnpm", "--filter", "@aurora/api", "start"]
